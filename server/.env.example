MONGO_URI=mongodb://127.0.0.1:27017/ai-finance
JWT_SECRET=your_jwt_secret_here
PORT=5000
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Grafana Cloud / OpenTelemetry
OTEL_SERVICE_NAME=mern-backend
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production

# Copy the exact endpoint from Grafana Cloud.
# Use the base OTLP endpoint expected by the exporters (e.g. https://otlp-gateway-prod-us-east-0.grafana.net/otlp)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Use the exact authentication header format supplied by Grafana Cloud (e.g. Authorization=Basic <base64_credentials>)
OTEL_EXPORTER_OTLP_HEADERS=

# Optional monitoring controls
OTEL_ENABLED=true
OTEL_METRICS_EXPORT_INTERVAL_MS=60000
OTEL_EXPORT_TIMEOUT_MS=5000
